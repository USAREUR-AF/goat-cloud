#!/usr/bin/env python3
"""Compliance tag linter — validates IaC configs against the compliance contract.

Checks that required tags are present with valid values in Terraform,
Serverless Framework, Pulumi, and CDK configurations.

Usage:
    compliance-lint --iac-type terraform --path .
    compliance-lint --iac-type serverless --path serverless.yml
    compliance-lint --iac-type pulumi --path .
    compliance-lint --contract-s3 s3://bucket/compliance-contract.json
    compliance-lint --contract-ssm /acme/dev/compliance-contract
"""

import argparse
import json
import os
import re
import sys

# Default contract: the fallback when no remote source is configured.
# BEGIN GENERATED CONTRACT - written by scripts/contract-gen from contract/contract.yaml. Do not edit.
