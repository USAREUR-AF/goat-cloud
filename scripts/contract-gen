#!/usr/bin/env python3
"""Generate every copy of the resource contract from contract/contract.yaml.

Usage:
    contract-gen                 write the generated files in this repository
    contract-gen --check         exit 1 when a generated file differs
    contract-gen --out-dir DIR [--mapping FILE] [--platform NAME ...]
                                 write the published JSON contract of each
                                 platform to DIR, with a deployment mapping
                                 applied when --mapping is given

contract/targets.yaml lists the generated files of this repository. Never
edit a generated file by hand.

Requires PyYAML.
"""

import argparse
import difflib
import json
import os
import re
import sys

import yaml

REPO_ROOT = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
CONTRACT_PATH = os.path.join("contract", "contract.yaml")

TARGETS_PATH = os.path.join("contract", "targets.yaml")

SUPPORTED_MAJOR_VERSION = "1"
REGISTRY_ENTRY = "registry-entry"
# What may hold a fact. The list is open: a later minor version adds carriers,
# and a carrier not listed here is reported as a note, never refused.
KNOWN_CARRIERS = (
    "tag",
    "label",
    "annotation",
    "resource-manager-tag",
    "custom-field",
    REGISTRY_ENTRY,
    "inventory-record",
)
# Carriers that hold a fact on something other than the resource, without a key.
KEYLESS_CARRIERS = (REGISTRY_ENTRY, "inventory-record")

# The entries this version reads. Any other entry is reported as a note and
# ignored, so a contract of a later minor version still loads.
_KNOWN_TOP = {"schema_version", "facts", "rules", "encodings", "renderings"}
_KNOWN_FACT = {"description", "required", "allowed", "not_iac_tools", "pattern", "protected_values", "canonical_form"}
_KNOWN_RULE = {"id", "description", "when", "require"}
_KNOWN_ENCODING = {"description", "pattern"}
_KNOWN_RENDERING = {
    "unit",
    "carrier",
    "key_prefix",
    "required",
    "legacy_aliases",
    "key_pattern",
    "value_pattern",
    "facts",
}
_KNOWN_RENDERED_FACT = {"key", "encoding", "carrier"}
LINE_LENGTH = 120

LINT_BEGIN = "# BEGIN GENERATED CONTRACT - written by scripts/contract-gen from contract/contract.yaml. Do not edit."
LINT_END = "# END GENERATED CONTRACT"

_HEADER_LINES = (
    "GENERATED by scripts/contract-gen from contract/contract.yaml. Do not edit.",
    "Change contract/contract.yaml, then run scripts/contract-gen.",
)


class ContractError(Exception):
    """The contract or a mapping file is not valid."""


# ---------------------------------------------------------------------------
# Load and validate
# ---------------------------------------------------------------------------


def _read_yaml(path):
    try:
        with open(path, encoding="utf-8") as f:
            data = yaml.safe_load(f)
    except (OSError, yaml.YAMLError) as e:
        raise ContractError(f"{path}: {e}") from e
    if not isinstance(data, dict):
        raise ContractError(f"{path}: expected a mapping at the top level")
    return data


def _require(cond, message):
    if not cond:
        raise ContractError(message)


def _string_list(value, where):
    _require(isinstance(value, list) and all(isinstance(v, str) and v for v in value), f"{where}: expected a list")
    _require(len(set(value)) == len(value), f"{where}: duplicate value")
    return value


def _note_unknown(notes, value, known, where):
    if notes is not None:
        notes.extend(f"{where}: unknown entry {name} is ignored" for name in value if name not in known)


def validate_contract(contract, notes=None):
    """Raise ContractError when the contract is not well formed.

    An entry or a carrier this version does not know is appended to `notes`
    when a list is given, and is never an error.
    """
    version = str(contract.get("schema_version"))
    _require(
        version.split(".")[0] == SUPPORTED_MAJOR_VERSION,
        f"schema_version {contract.get('schema_version')!r} is not supported (supported: {SUPPORTED_MAJOR_VERSION}.x)",
    )
    _note_unknown(notes, contract, _KNOWN_TOP, "contract")

    facts = contract.get("facts")
    _require(isinstance(facts, dict) and facts, "facts: expected a non-empty mapping")
    for name, fact in facts.items():
        _require(isinstance(fact, dict), f"facts.{name}: expected a mapping")
        _note_unknown(notes, fact, _KNOWN_FACT, f"facts.{name}")
        _require(isinstance(fact.get("required"), bool), f"facts.{name}.required: expected true or false")
        for entry in ("allowed", "protected_values"):
            if entry in fact:
                _string_list(fact[entry], f"facts.{name}.{entry}")
        if "allowed" in fact and "protected_values" in fact:
            extra = set(fact["protected_values"]) - set(fact["allowed"])
            _require(not extra, f"facts.{name}.protected_values: not in allowed: {', '.join(sorted(extra))}")
        if "not_iac_tools" in fact:
            extra = set(_string_list(fact["not_iac_tools"], f"facts.{name}.not_iac_tools")) - set(
                fact.get("allowed", [])
            )
            _require(not extra, f"facts.{name}.not_iac_tools: not in allowed: {', '.join(sorted(extra))}")
        if "pattern" in fact:
            _compile(fact["pattern"], f"facts.{name}.pattern")
    for name in ("managed_by", "lifecycle"):
        _require(name in facts and facts[name].get("allowed"), f"facts.{name}: allowed values are required")
    for name in ("environment", "expires_at", "repository"):
        _require(name in facts, f"facts.{name} is required")

    for i, rule in enumerate(contract.get("rules", [])):
        where = f"rules[{i}]"
        _require(isinstance(rule, dict) and rule.get("id"), f"{where}: id is required")
        _note_unknown(notes, rule, _KNOWN_RULE, where)
        when = rule.get("when") or {}
        _require(when.get("fact") in facts, f"{where}.when.fact: unknown fact {when.get('fact')!r}")
        allowed = facts[when["fact"]].get("allowed")
        if allowed:
            _require(when.get("equals") in allowed, f"{where}.when.equals: not an allowed value")
        for fact in _string_list(rule.get("require"), f"{where}.require"):
            _require(fact in facts, f"{where}.require: unknown fact {fact!r}")

    encodings = contract.get("encodings")
    _require(isinstance(encodings, dict) and encodings, "encodings: expected a non-empty mapping")
    for name, encoding in encodings.items():
        _require(
            isinstance(encoding, dict) and isinstance(encoding.get("description"), str),
            f"encodings.{name}: expected a mapping with a description",
        )
        _note_unknown(notes, encoding, _KNOWN_ENCODING, f"encodings.{name}")
        if "pattern" in encoding:
            _compile(encoding["pattern"], f"encodings.{name}.pattern")

    renderings = contract.get("renderings")
    _require(isinstance(renderings, dict) and renderings, "renderings: expected a non-empty mapping")
    for platform, rendering in renderings.items():
        where = f"renderings.{platform}"
        _require(isinstance(rendering, dict), f"{where}: expected a mapping")
        _note_unknown(notes, rendering, _KNOWN_RENDERING, where)
        for entry in ("unit", "carrier"):
            _require(isinstance(rendering.get(entry), str) and rendering[entry], f"{where}.{entry} is required")
        _require(isinstance(rendering.get("key_prefix", ""), str), f"{where}.key_prefix: expected text")
        if "required" in rendering:
            unknown = [n for n in _string_list(rendering["required"], f"{where}.required") if n not in facts]
            _require(not unknown, f"{where}.required: unknown fact {', '.join(unknown)}")
        rendered = rendering.get("facts")
        _require(isinstance(rendered, dict), f"{where}.facts: expected a mapping")
        missing = set(facts) - set(rendered)
        unknown = set(rendered) - set(facts)
        _require(not missing, f"{where}.facts: no rendering for {', '.join(sorted(missing))}")
        _require(not unknown, f"{where}.facts: unknown fact {', '.join(sorted(unknown))}")
        for name, entry in rendered.items():
            at = f"{where}.facts.{name}"
            _require(isinstance(entry, dict) and "key" in entry, f"{at}: key is required")
            _note_unknown(notes, entry, _KNOWN_RENDERED_FACT, at)
            carrier = entry.get("carrier", rendering["carrier"])
            _require(isinstance(carrier, str) and carrier, f"{at}.carrier: expected a carrier name")
            if carrier not in KNOWN_CARRIERS and notes is not None:
                notes.append(f"{at}.carrier: unknown carrier {carrier!r} (known: {', '.join(KNOWN_CARRIERS)})")
            if carrier == REGISTRY_ENTRY:
                _require(entry["key"] is None, f"{at}: a fact carried by the {REGISTRY_ENTRY} has key: null")
            elif entry["key"] is None:
                _require(
                    carrier in KEYLESS_CARRIERS,
                    f"{at}: a fact carried by a {carrier} needs a key; a fact without one is carried by the {REGISTRY_ENTRY}",
                )
            else:
                _require(isinstance(entry["key"], str) and entry["key"], f"{at}.key: expected a key")
                _require(
                    entry.get("encoding") in encodings,
                    f"{at}.encoding: unknown encoding {entry.get('encoding')!r}",
                )
        _validate_rendering(contract, platform, rendering)


def _compile(pattern, where):
    try:
        return re.compile(pattern)
    except (re.error, TypeError) as e:
        raise ContractError(f"{where}: {e}") from e


def _fact_carrier(rendering, name):
    return rendering["facts"][name].get("carrier", rendering["carrier"])


def _validate_rendering(contract, platform, rendering):
    """Check the keys, and the allowed values, against the limits of one platform."""
    where = f"renderings.{platform}"
    by_carrier = {}
    for name, entry in rendering["facts"].items():
        if entry["key"] is not None:
            by_carrier.setdefault(_fact_carrier(rendering, name), []).append(entry["key"])
    for keys in by_carrier.values():
        duplicates = sorted({k for k in keys if keys.count(k) > 1})
        _require(not duplicates, f"{where}: key used by more than one fact: {', '.join(duplicates)}")
    # The key and value limits of a rendering are the limits of its labels.
    labels = [name for name in rendering["facts"] if _fact_carrier(rendering, name) == "label"]
    prefix = rendering.get("key_prefix", "")
    key_pattern = rendering.get("key_pattern")
    if key_pattern:
        keys = [prefix + rendering["facts"][n]["key"] for n in labels]
        bad = [k for k in keys if not re.match(key_pattern, k)]
        _require(not bad, f"{where}: key does not match key_pattern {key_pattern}: {', '.join(bad)}")
    value_pattern = rendering.get("value_pattern")
    if value_pattern:
        for name in labels:
            fact = contract["facts"][name]
            values = [*fact.get("allowed", []), *fact.get("protected_values", [])]
            bad = [v for v in values if not re.match(value_pattern, v)]
            _require(not bad, f"{where}.facts.{name}: value does not match value_pattern: {', '.join(bad)}")


def load_contract(path=None, notes=None):
    """Read and validate contract.yaml. Entries this version does not know go to `notes`."""
    contract = _read_yaml(path or os.path.join(REPO_ROOT, CONTRACT_PATH))
    validate_contract(contract, notes)
    return contract


def apply_mapping(contract, mapping):
    """Return the contract with a deployment mapping applied.

    A mapping renames keys, changes the carrier of a fact (`kind` is read as
    the earlier name of `carrier`), replaces the required set, sets a key
    prefix, and sets the allowed and protected environment names. It cannot
    add a fact, a platform, a rule, or a value of any other fact.
    """
    allowed_top = {"contract_schema_version", "required", "environment", "renderings"}
    unknown = set(mapping) - allowed_top
    _require(not unknown, f"mapping: unknown entry {', '.join(sorted(unknown))}")
    _require(
        str(mapping.get("contract_schema_version")).split(".")[0] == str(contract["schema_version"]).split(".")[0],
        f"mapping: contract_schema_version must be of major version {str(contract['schema_version']).split('.')[0]}",
    )

    result = json.loads(json.dumps(contract))
    facts = result["facts"]

    def required_set(value, where):
        names = _string_list(value, where)
        bad = [n for n in names if n not in facts]
        _require(not bad, f"{where}: unknown fact {', '.join(bad)}")
        return names

    if "required" in mapping:
        names = required_set(mapping["required"], "mapping.required")
        for name, fact in facts.items():
            fact["required"] = name in names
        # The set replaces the required set of every platform, also one the contract states per platform.
        for rendering in result["renderings"].values():
            rendering.pop("required", None)

    environment = mapping.get("environment", {})
    _require(isinstance(environment, dict), "mapping.environment: expected a mapping")
    unknown = set(environment) - {"allowed", "protected_values"}
    _require(not unknown, f"mapping.environment: unknown entry {', '.join(sorted(unknown))}")
    for entry in ("allowed", "protected_values"):
        if entry in environment:
            facts["environment"][entry] = _string_list(environment[entry], f"mapping.environment.{entry}")

    for platform, override in (mapping.get("renderings") or {}).items():
        where = f"mapping.renderings.{platform}"
        _require(platform in result["renderings"], f"{where}: unknown platform")
        _require(isinstance(override, dict), f"{where}: expected a mapping")
        unknown = set(override) - {"required", "key_prefix", "facts"}
        _require(not unknown, f"{where}: unknown entry {', '.join(sorted(unknown))}")
        rendering = result["renderings"][platform]
        if "key_prefix" in override:
            rendering["key_prefix"] = override["key_prefix"]
        if "required" in override:
            rendering["required"] = required_set(override["required"], f"{where}.required")
        for name, entry in (override.get("facts") or {}).items():
            at = f"{where}.facts.{name}"
            _require(name in facts, f"{where}.facts: unknown fact {name!r}")
            _require(
                isinstance(entry, dict) and entry and set(entry) <= {"key", "carrier", "kind", "encoding"},
                f"{at}: expected key, carrier or encoding",
            )
            entry = dict(entry)
            if "kind" in entry:
                # `kind` is the earlier name of `carrier`.
                kind = entry.pop("kind")
                entry.setdefault("carrier", kind)
            merged = {**rendering["facts"][name], **entry}
            if merged.get("carrier", rendering["carrier"]) == REGISTRY_ENTRY:
                _require(entry.get("key") is None, f"{at}: a fact carried by the {REGISTRY_ENTRY} has no key")
                merged = {"key": None, "carrier": REGISTRY_ENTRY}
            rendering["facts"][name] = merged

    validate_contract(result)
    return result


# ---------------------------------------------------------------------------
# Resolve one platform
# ---------------------------------------------------------------------------


def resolve(contract, platform):
    """Flatten the contract for one platform: where each fact is written and what it may hold."""
    _require(platform in contract["renderings"], f"unknown platform {platform!r}")
    facts = contract["facts"]
    encodings = contract["encodings"]
    rendering = contract["renderings"][platform]
    rendered = rendering["facts"]
    prefix = rendering.get("key_prefix", "")
    keys = {name: prefix + rendered[name]["key"] for name in facts if rendered[name]["key"] is not None}
    if "required" in rendering:
        required = [name for name in facts if name in rendering["required"]]
    else:
        required = [name for name, fact in facts.items() if fact["required"]]
    managed_by = list(facts["managed_by"]["allowed"])
    not_iac = set(facts["managed_by"].get("not_iac_tools", []))

    patterns = {}
    for name, fact in facts.items():
        if "pattern" in fact:
            patterns[name] = fact["pattern"]
        elif name in keys and "pattern" in encodings[rendered[name]["encoding"]]:
            patterns[name] = encodings[rendered[name]["encoding"]]["pattern"]
    allowed = {name: list(fact["allowed"]) for name, fact in facts.items() if fact.get("allowed")}

    return {
        "version": contract["schema_version"],
        "platform": platform,
        "unit": rendering["unit"],
        "key_prefix": prefix,
        "legacy_aliases": bool(rendering.get("legacy_aliases")),
        "keys": keys,
        "carriers": {name: _fact_carrier(rendering, name) for name in facts},
        "required_facts": required,
        "required_keys": [keys[name] for name in required if name in keys],
        "optional_keys": [keys[name] for name in facts if name in keys and name not in required],
        "allowed": allowed,
        "patterns": patterns,
        "rules": [
            {"id": rule["id"], "when": dict(rule["when"]), "require": list(rule["require"])}
            for rule in contract.get("rules", [])
        ],
        "protected_values": {
            name: list(fact["protected_values"]) for name, fact in facts.items() if "protected_values" in fact
        },
        "managed_by": managed_by,
        "iac_tools": [v for v in managed_by if v not in not_iac],
        "lifecycle": list(facts["lifecycle"]["allowed"]),
        "validation": {
            keys[name]: ({"enum": allowed[name]} if name in allowed else {"pattern": patterns[name]})
            for name in facts
            if name in keys and (name in allowed or name in patterns)
        },
    }


def published_contract(resolved):
    """The contract as published to a platform and read by modules, lint and scanners.

    `platform`, `unit`, `required_facts`, `keys`, `carriers`, `allowed`,
    `patterns`, `rules` and `protected_values` have the same meaning on every
    platform. A rendering marked `legacy_aliases` also carries the earlier
    field names.
    """
    published = {
        "version": resolved["version"],
        "platform": resolved["platform"],
        "unit": resolved["unit"],
        "key_prefix": resolved["key_prefix"],
        "required_facts": resolved["required_facts"],
        "keys": resolved["keys"],
        "carriers": resolved["carriers"],
        "allowed": resolved["allowed"],
        "patterns": resolved["patterns"],
        "rules": resolved["rules"],
        "protected_values": resolved["protected_values"],
    }
    if resolved["legacy_aliases"]:
        published.update(
            {
                "required_tags": resolved["required_keys"],
                "valid_managed_by": resolved["managed_by"],
                "valid_lifecycle": resolved["lifecycle"],
                "tag_validation": resolved["validation"],
            }
        )
    return published


# ---------------------------------------------------------------------------
# Renderers
# ---------------------------------------------------------------------------


def _hcl(value):
    """A single-line HCL expression."""
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, list):
        return "[" + ", ".join(_hcl(v) for v in value) + "]"
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{k} = {_hcl(v)}" for k, v in value.items()) + " }" if value else "{}"
    raise TypeError(f"cannot render {type(value).__name__} as HCL")


def _hcl_attributes(pairs, indent):
    """Attribute lines with the equals signs aligned, as `terraform fmt` writes them."""
    width = max(len(k) for k, _ in pairs)
    return [f"{indent}{k.ljust(width)} = {_hcl(v)}" for k, v in pairs]


def _hcl_object(value, indent):
    """The attribute lines of an object, laid out the way `terraform fmt` leaves them.

    A string or a list of strings is one line; consecutive one-line attributes
    align. A nested object becomes a block of one-line attributes, and a list of
    objects one object per line.
    """
    lines, run = [], []

    def flush():
        if run:
            lines.extend(_hcl_attributes(run, indent))
            run.clear()

    for key, item in value.items():
        if isinstance(item, dict) and item:
            flush()
            lines += [f"{indent}{key} = {{", *_hcl_attributes(list(item.items()), indent + "  "), f"{indent}}}"]
        elif isinstance(item, list) and item and all(isinstance(v, dict) for v in item):
            flush()
            lines += [f"{indent}{key} = [", *[f"{indent}  {_hcl(v)}," for v in item], f"{indent}]"]
        else:
            run.append((key, item))
    flush()
    return lines


def _hash_header():
    return [f"# {line}" for line in _HEADER_LINES]


def render_hcl_tags(resolved, options=None):
    """Locals file holding the published contract of one platform, for a module."""
    lines = [*_hash_header(), "", "locals {", "  generated_contract = {"]
    lines += _hcl_object(published_contract(resolved), "    ")
    lines += ["  }", "}", ""]
    return "\n".join(lines)


def render_hcl_registry(resolved, options=None):
    """The iac_type variable of a registry module, and the values its optional lifecycle fields accept."""
    options = options or {}
    tools = resolved["iac_tools"]
    default = options.get("default")
    _require(default is None or default in tools, f"iac_type default {default!r} is not an IaC tool of the contract")
    attributes = [("description", options.get("description", "IaC tool type")), ("type", None)]
    if default is not None:
        attributes.append(("default", default))
    width = max(len(k) for k, _ in attributes)
    lines = [
        *_hash_header(),
        "",
        "# tflint-ignore: terraform_standard_module_structure",
        'variable "iac_type" {',
        *[f"  {k.ljust(width)} = {'string' if v is None else json.dumps(v)}" for k, v in attributes],
        "",
        "  validation {",
        f"    condition     = contains({_hcl(tools)}, lower(var.iac_type))",
        f"    error_message = {json.dumps('iac_type must be one of: ' + ', '.join(tools))}",
        "  }",
        "}",
        "",
        "# The lifecycle values a registry entry accepts, the ones that require an",
        "# expiry, and the form of the expiry.",
        "locals {",
        *_hcl_attributes(
            [
                ("registry_lifecycle_values", resolved["lifecycle"]),
                ("registry_expiry_lifecycles", _expiry_lifecycles(resolved["rules"])),
                ("registry_expires_at_pattern", resolved["patterns"]["expires_at"]),
            ],
            "  ",
        ),
        "}",
        "",
    ]
    return "\n".join(lines)


def _expiry_lifecycles(rules):
    """The lifecycle values for which a rule requires an expiry."""
    return [
        rule["when"]["equals"]
        for rule in rules
        if rule["when"]["fact"] == "lifecycle" and "expires_at" in rule["require"]
    ]


def _py_entry(prefix, value, indent, trailing=0):
    """`prefix` followed by a Python literal, laid out the way `ruff format` leaves it."""
    pad = " " * indent
    if isinstance(value, dict) and value:
        inner = "".join(_py_entry(f"{json.dumps(k)}: ", v, indent + 4, trailing=1) + ",\n" for k, v in value.items())
        return f"{pad}{prefix}{{\n{inner}{pad}}}"
    if isinstance(value, list) and any(isinstance(v, dict) for v in value):
        inner = "".join(_py_entry("", v, indent + 4, trailing=1) + ",\n" for v in value)
        return f"{pad}{prefix}[\n{inner}{pad}]"
    if isinstance(value, list):
        line = f"{pad}{prefix}[" + ", ".join(json.dumps(v) for v in value) + "]"
        if len(line) + trailing <= LINE_LENGTH:
            return line
        items = "".join(f"{pad}    {json.dumps(v)},\n" for v in value)
        return f"{pad}{prefix}[\n{items}{pad}]"
    return f"{pad}{prefix}{json.dumps(value)}"


def _py_assign(name, value):
    """`name = literal`."""
    return _py_entry(f"{name} = ", value, 0)


# The functions every generated Python module carries. They use only the
# constants defined above them in that module.
_PYTHON_FUNCTIONS = r'''
_EXPIRES_AT_RE = re.compile(EXPIRES_AT_PATTERN)
_COMPACT_UTC_RE = re.compile(r"^(\d{4})(\d{2})(\d{2})t(\d{2})(\d{2})z$")
_URL_RE = re.compile(r"^([a-zA-Z][a-zA-Z0-9+.-]*)://(?:[^@/]*@)?([^/]+)(?:/(.*))?$")
_SCP_RE = re.compile(r"^(?:[^@/:]+@)?([^@/:]+):(.*)$")


def expires_at_is_valid(value):
    """True when an expiry value has the form the contract requires on this platform."""
    return isinstance(value, str) and bool(_EXPIRES_AT_RE.fullmatch(value))


def parse_expires_at(value):
    """Return the moment an expiry value names, as a UTC datetime, or None.

    Reads the contract's forms and also a date alone or a timestamp without a
    zone, both taken as UTC, so that a value in the wrong form still expires.
    Whether the value has the required form is a separate question: ask
    expires_at_is_valid and report a value that fails it.
    """
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    compact = _COMPACT_UTC_RE.match(text)
    try:
        if compact:
            return datetime(*(int(part) for part in compact.groups()), tzinfo=UTC)
        moment = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    if moment.tzinfo is None:
        return moment.replace(tzinfo=UTC)
    return moment.astimezone(UTC)


def is_allowed(fact, value):
    """True when the contract accepts a value for a fact.

    A fact with no list of accepted values accepts any value. A fact in
    CASE_INSENSITIVE_FACTS compares without regard to case; any other fact
    compares exactly.
    """
    allowed = ALLOWED_VALUES.get(fact)
    if not allowed:
        return True
    if not isinstance(value, str):
        return False
    if fact in CASE_INSENSITIVE_FACTS:
        return value.lower() in {v.lower() for v in allowed}
    return value in allowed


def expiry_required(lifecycle):
    """True when the contract requires an expiry for this lifecycle value."""
    return isinstance(lifecycle, str) and lifecycle.lower() in EXPIRY_REQUIRED_LIFECYCLES


def normalize_repository(value):
    """Return a repository value in the contract's canonical form.

    https scheme, lowercase host, no user name, no trailing ".git" and no
    trailing slash. "git@host:org/repo.git", "ssh://git@host/org/repo.git" and
    "https://Host/org/repo/" all become "https://host/org/repo". Compare a tag
    value with a registry entry only after normalizing both. A value that is
    not a repository address is returned stripped and otherwise unchanged.
    """
    text = (value or "").strip()
    if not text:
        return ""
    url = _URL_RE.match(text)
    if url:
        scheme, host, path = url.group(1).lower(), url.group(2), url.group(3) or ""
        if scheme not in ("http", "https"):
            host = host.split(":", 1)[0]
    else:
        scp = _SCP_RE.match(text)
        if not scp:
            return text
        host, path = scp.group(1), scp.group(2)
    path = path.strip("/")
    if path.endswith(".git"):
        path = path[: -len(".git")].rstrip("/")
    return f"https://{host.lower()}/{path}" if path else f"https://{host.lower()}"


def same_repository(left, right):
    """True when two repository values name the same repository."""
    return bool(left) and bool(right) and normalize_repository(left) == normalize_repository(right)
'''


def render_python(resolved, options=None):
    """A Python module of contract constants and the functions that apply them."""
    rules = resolved["rules"]
    keys = resolved["keys"]
    expiry_lifecycles = _expiry_lifecycles(rules)
    lines = [
        '"""Resource contract constants.',
        "",
        *_HEADER_LINES,
        "",
        "compliance_schema.py re-exports these names. Each Lambda build copies this",
        "file into its archive beside compliance_schema.py.",
        '"""',
        "",
        "import re",
        "from datetime import UTC, datetime",
        "",
        _py_assign("CONTRACT_VERSION", resolved["version"]),
        "",
        "# Contract fact -> tag key.",
        _py_assign("TAG_KEYS", keys),
        "",
        "# Facts every resource states, and their tag keys.",
        _py_assign("REQUIRED_FACTS", resolved["required_facts"]),
        _py_assign("REQUIRED_TAGS", resolved["required_keys"]),
        "",
        "# Tag keys the contract defines and does not require.",
        _py_assign("OPTIONAL_TAGS", resolved["optional_keys"]),
        "",
        "# Contract fact -> the only accepted values.",
        _py_assign("ALLOWED_VALUES", resolved["allowed"]),
        "",
        "# Facts whose values compare without regard to case.",
        _py_assign("CASE_INSENSITIVE_FACTS", ["managed_by"]),
        "",
        "# Accepted values of the managed-by tag, in contract order.",
        _py_assign("IAC_TYPES", resolved["managed_by"]),
        "VALID_MANAGED_BY = frozenset(IAC_TYPES)",
        "",
        "# Accepted values of the lifecycle tag, in contract order.",
        _py_assign("LIFECYCLE_VALUES", resolved["lifecycle"]),
        "VALID_LIFECYCLE = frozenset(LIFECYCLE_VALUES)",
        "",
        "# Lifecycle values that require an expiry.",
        _py_assign("EXPIRY_REQUIRED_LIFECYCLES", expiry_lifecycles),
        "",
        "# Accepted environment names; an empty list accepts any name.",
        _py_assign("ENVIRONMENT_ALLOWED", resolved["allowed"].get("environment", [])),
        "",
        "# Environments whose resources enforcement never removes.",
        _py_assign("PROTECTED_ENVIRONMENTS", resolved["protected_values"].get("environment", [])),
        "",
        "# Contract fact -> regular expression its value matches.",
        _py_assign("PATTERNS", resolved["patterns"]),
        _py_assign("REPOSITORY_PATTERN", resolved["patterns"]["repository"]),
        _py_assign("EXPIRES_AT_PATTERN", resolved["patterns"]["expires_at"]),
        "",
        "# Rules that make a fact required when another fact has a given value.",
        _py_assign("RULES", rules),
        _PYTHON_FUNCTIONS,
    ]
    return "\n".join(lines)


def render_json(resolved, options=None):
    """The published JSON contract of one platform."""
    return json.dumps(published_contract(resolved), indent=2) + "\n"


def render_lint_block(resolved):
    """The fallback contract inside scripts/compliance-lint, markers included."""
    return "\n".join([LINT_BEGIN, _py_assign("_DEFAULT_CONTRACT", published_contract(resolved)), LINT_END])


def render_lint(resolved, current, path="script"):
    """A script with its generated block replaced."""
    begin = current.find(LINT_BEGIN)
    end = current.find(LINT_END)
    _require(begin != -1 and end > begin, f"{path}: GENERATED CONTRACT markers not found")
    return current[:begin] + render_lint_block(resolved) + current[end + len(LINT_END) :]


TARGET_KINDS = {
    "hcl-locals": render_hcl_tags,
    "hcl-iac-type-variable": render_hcl_registry,
    "python-constants": render_python,
    "published-json": render_json,
    "python-block": None,  # rewrites part of an existing file; see generated_files
}


# Optional entries of a target, by kind.
TARGET_OPTIONS = {"hcl-iac-type-variable": ("description", "default")}


def load_targets(root=REPO_ROOT):
    """Read contract/targets.yaml: the generated files of the repository."""
    targets = _read_yaml(os.path.join(root, TARGETS_PATH)).get("targets")
    _require(isinstance(targets, list) and targets, f"{TARGETS_PATH}: expected a non-empty targets list")
    seen = set()
    for i, target in enumerate(targets):
        where = f"{TARGETS_PATH}: targets[{i}]"
        _require(isinstance(target, dict), f"{where}: expected path, kind, platform")
        if "cloud" in target and "platform" not in target:
            # `cloud` is the earlier name of `platform`.
            target["platform"] = target.pop("cloud")
        _require({"path", "kind", "platform"} <= set(target), f"{where}: expected path, kind, platform")
        unknown = set(target) - {"path", "kind", "platform"} - set(TARGET_OPTIONS.get(target.get("kind"), ()))
        _require(not unknown, f"{where}: unknown entry {', '.join(sorted(unknown))}")
        path = target["path"]
        _require(isinstance(path, str) and path, f"{where}.path: expected a path")
        _require(
            not os.path.isabs(path) and ".." not in path.split("/"), f"{where}.path: must stay inside the repository"
        )
        _require(path not in seen, f"{where}.path: listed twice")
        _require(target["kind"] in TARGET_KINDS, f"{where}.kind: expected one of {', '.join(TARGET_KINDS)}")
        seen.add(path)
    return targets


def generated_files(contract, root=REPO_ROOT):
    """Map each generated file (path relative to root) to its expected content."""
    files = {}
    for target in load_targets(root):
        rel = os.path.join(*target["path"].split("/"))
        resolved = resolve(contract, target["platform"])
        render = TARGET_KINDS[target["kind"]]
        if render is not None:
            files[rel] = render(resolved, {k: v for k, v in target.items() if k not in ("path", "kind", "platform")})
            continue
        try:
            with open(os.path.join(root, rel), encoding="utf-8") as f:
                current = f.read()
        except OSError as e:
            raise ContractError(f"{target['path']}: {e}") from e
        files[rel] = render_lint(resolved, current, target["path"])
    return files


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------


def _read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return None


def check(contract, root=REPO_ROOT, out=sys.stderr):
    """Return the generated files that differ from what the contract produces."""
    stale = []
    for rel, expected in generated_files(contract, root).items():
        current = _read(os.path.join(root, rel))
        if current == expected:
            continue
        stale.append(rel)
        if current is None:
            print(f"MISSING  {rel}", file=out)
            continue
        print(f"DIFFERS  {rel}", file=out)
        diff = difflib.unified_diff(
            current.splitlines(), expected.splitlines(), f"{rel} (committed)", f"{rel} (generated)", lineterm="", n=1
        )
        for line in diff:
            print(f"  {line}", file=out)
    return stale


def write(contract, root=REPO_ROOT, out=sys.stdout):
    """Write every generated file; return the ones that changed."""
    changed = []
    for rel, expected in generated_files(contract, root).items():
        path = os.path.join(root, rel)
        if _read(path) == expected:
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(expected)
        changed.append(rel)
        print(f"wrote  {rel}", file=out)
    return changed


def write_published(contract, out_dir, platforms=None, out=sys.stdout):
    """Write compliance-contract.<platform>.json for each platform into out_dir."""
    os.makedirs(out_dir, exist_ok=True)
    paths = []
    for platform in platforms or list(contract["renderings"]):
        path = os.path.join(out_dir, f"compliance-contract.{platform}.json")
        with open(path, "w", encoding="utf-8") as f:
            f.write(render_json(resolve(contract, platform)))
        paths.append(path)
        print(f"wrote  {path}", file=out)
    return paths


def main(argv=None):
    parser = argparse.ArgumentParser(description="Generate every copy of the resource contract.")
    parser.add_argument("--check", action="store_true", help="exit 1 when a generated file differs; write nothing")
    parser.add_argument("--contract", help=f"contract file (default: {CONTRACT_PATH})")
    parser.add_argument("--mapping", help="deployment mapping file; needs --out-dir")
    parser.add_argument("--out-dir", help="write the published JSON contract of each platform to this directory")
    parser.add_argument("--platform", action="append", help="with --out-dir: only this platform (repeatable)")
    parser.add_argument("--cloud", action="append", dest="platform", help="deprecated: the earlier name of --platform")
    args = parser.parse_args(argv)

    if args.mapping and not args.out_dir:
        parser.error("--mapping needs --out-dir: the files generated in this repository never carry a mapping")
    if args.check and args.out_dir:
        parser.error("--check and --out-dir cannot be combined")
    if args.platform and not args.out_dir:
        parser.error("--platform needs --out-dir")

    try:
        notes = []
        contract = load_contract(args.contract, notes)
        for note in notes:
            print(f"note: {note}", file=sys.stderr)
        if args.out_dir:
            if args.mapping:
                contract = apply_mapping(contract, _read_yaml(args.mapping))
            write_published(contract, args.out_dir, args.platform)
            return 0
        if args.check:
            stale = check(contract)
            if stale:
                print(f"\n{len(stale)} generated file(s) differ from {CONTRACT_PATH}.", file=sys.stderr)
                print("Run scripts/contract-gen and commit the result.", file=sys.stderr)
                return 1
            print(f"Generated files match {CONTRACT_PATH}.")
            return 0
        if not write(contract):
            print(f"Generated files already match {CONTRACT_PATH}.")
        return 0
    except ContractError as e:
        print(f"contract-gen: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
